# --- core (apps/core) ---
# Local dev uses PGlite (in-process) when DATABASE_URL is unset. Set it to use real Postgres/Supabase.
DATABASE_URL=
PACELINE_DATA_DIR=.pglite
PORT=8787
PUBLIC_URL=http://localhost:8787
# Ed25519 signing key for setup patches and owner instructions (base64 PKCS8). Generated on first run in dev.
PACELINE_SIGNING_KEY=
# Shared secret between apps/mcp and core /internal/* (HMAC). Any long random string.
PACELINE_INTERNAL_SECRET=
# Key for per-team HMACs of repo_key / machine labels.
PACELINE_HMAC_KEY=
# LLM + embeddings. Leave empty to use deterministic mock providers (dev/tests).
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
PACELINE_LLM=mock        # mock | anthropic
PACELINE_EMBEDDINGS=mock # mock | gateway
# Supabase (production auth / OAuth). Optional in local dev (dev login is used instead).
SUPABASE_URL=
SUPABASE_JWKS_URL=
# --- mcp (apps/mcp) ---
PACELINE_CORE_URL=http://localhost:8787
MCP_URL=http://localhost:3000
