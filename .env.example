# Paceline environment. Local dev needs none of this (PGlite, dev login, mock LLM/embeddings).
# Production values: docs/DEPLOY.md (core: §5, mcp: §7, web: §8). Full core reference: apps/core/README.md.

# --- core (apps/core) ---------------------------------------------------------
NODE_ENV=                    # production: required-secret checks on, dev login off (unless PACELINE_DEMO_SECRET)
PACELINE_MODE=               # server (default) | serverless (implied by VERCEL)
PORT=8787
PUBLIC_URL=http://localhost:8787
# Database: unset DATABASE_URL = PGlite in PACELINE_DATA_DIR (`memory` for a throwaway DB).
# Vercel: the Supabase transaction pooler (port 6543); serverless core never LISTENs.
DATABASE_URL=
PACELINE_DB_FLAVOR=          # pglite | postgres | supabase (default supabase when DATABASE_URL is set)
PACELINE_DATA_DIR=.pglite
# Secrets (random per process in dev; required in production). `openssl rand -hex 32` each.
PACELINE_INTERNAL_SECRET=    # HMAC between apps/mcp and core /internal/mcp/*; same value on both
PACELINE_HMAC_KEY=           # repo/machine HMACs and digest sealing
PACELINE_SIGNING_KEY=        # Ed25519 PKCS8 (base64) for owner instructions and setup patches
PACELINE_CRON_SECRET=        # >= 16 chars; Bearer for POST /internal/jobs/tick (same value in Vault: paceline_jobs_tick_secret)
# Supabase auth + realtime
SUPABASE_URL=                # enables Supabase JWT verification (JWKS derived from it)
SUPABASE_JWKS_URL=           # override the derived JWKS URL
SUPABASE_JWT_SECRET=         # HS256 fallback for legacy-secret projects
SUPABASE_PUBLISHABLE_KEY=    # publishable (anon) key: returned in Me.realtime / AgentBrief.realtime (SUPABASE_ANON_KEY also read)
SUPABASE_SERVICE_ROLE_KEY=   # server only: realtime REST fallback
PACELINE_REALTIME_REST=auto  # auto | on | off (core broadcasting in addition to the events trigger)
# Browsers and the hosted demo
PACELINE_WEB_ORIGIN=         # comma list; dev default http://localhost:5173,http://127.0.0.1:5173
PACELINE_DEMO_SECRET=        # >= 16 chars; gates /api/v1/dev/* behind X-Demo-Secret (the only dev login in production)
PACELINE_DEV_AUTH=           # explicit on/off for /api/v1/dev/*
# Install command on the connect page
PACELINE_MCP_URL=            # dev default http://localhost:3000/mcp
PACELINE_PLUGIN_MARKETPLACE= # default thomas-jichen/Y
# Models. Leave mock for dev/tests.
PACELINE_LLM=mock            # mock | anthropic (not wired in v0)
ANTHROPIC_API_KEY=
PACELINE_EMBEDDINGS=mock     # mock | gte (gte-small via the Supabase `embed` Edge Function)
PACELINE_EMBED_URL=          # default SUPABASE_URL
PACELINE_EMBED_SECRET=       # required with gte (x-paceline-embed-secret)
PACELINE_DEBUG=

# --- mcp (apps/mcp) -----------------------------------------------------------
PACELINE_CORE_URL=http://127.0.0.1:8787
PACELINE_WEB_URL=http://localhost:5173
PACELINE_CORE_TIMEOUT_MS=20000

# --- web (apps/web, Vite: baked in at build time, public by design) -----------
VITE_MOCKS=                  # 1 = mock data; unset with no VITE_API_URL also means mocks
VITE_API_URL=                # e.g. https://paceline-core.vercel.app/api/v1; unset = same-origin /api/v1, proxied to PACELINE_CORE_URL
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=      # the publishable key, never a secret key
VITE_DEMO_SECRET=            # hosted demo only; ships in the bundle
VITE_DEV_LOGIN=              # 1 shows the dev/demo login form
