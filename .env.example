# Y environment. Local dev needs none of this (PGlite, dev login, mock LLM/embeddings).
# Production values: docs/DEPLOY.md (core: §5, mcp: §7, web: §8). Full core reference: apps/core/README.md.

# --- core (apps/core) ---------------------------------------------------------
NODE_ENV=                    # production: required-secret checks on, dev login off (unless Y_DEMO_SECRET)
Y_MODE=               # server (default) | serverless (implied by VERCEL)
PORT=8787
PUBLIC_URL=http://localhost:8787
# Database: unset DATABASE_URL = PGlite in Y_DATA_DIR (`memory` for a throwaway DB).
# Vercel: the Supabase transaction pooler (port 6543); serverless core never LISTENs.
DATABASE_URL=
Y_DB_FLAVOR=          # pglite | postgres | supabase (default supabase when DATABASE_URL is set)
Y_DATA_DIR=.pglite
# Secrets (random per process in dev; required in production). `openssl rand -hex 32` each.
Y_INTERNAL_SECRET=    # HMAC between apps/mcp and core /internal/mcp/*; same value on both
Y_HMAC_KEY=           # repo/machine HMACs and digest sealing
Y_SIGNING_KEY=        # Ed25519 PKCS8 (base64) for owner instructions and setup patches
Y_CRON_SECRET=        # >= 16 chars; Bearer for POST /internal/jobs/tick (same value in Vault: y_jobs_tick_secret)
# Supabase auth + realtime
SUPABASE_URL=                # enables Supabase JWT verification (JWKS derived from it)
SUPABASE_JWKS_URL=           # override the derived JWKS URL
SUPABASE_JWT_SECRET=         # HS256 fallback for legacy-secret projects
SUPABASE_PUBLISHABLE_KEY=    # publishable (anon) key: returned in Me.realtime / AgentBrief.realtime (SUPABASE_ANON_KEY also read)
SUPABASE_SERVICE_ROLE_KEY=   # server only: realtime REST fallback
Y_REALTIME_REST=auto  # auto | on | off (core broadcasting in addition to the events trigger)
# Browsers and the hosted demo
Y_WEB_ORIGIN=         # comma list; dev default http://localhost:5173,http://127.0.0.1:5173
Y_DEMO_SECRET=        # >= 16 chars; gates /api/v1/dev/* behind X-Demo-Secret (the only dev login in production)
Y_DEV_AUTH=           # explicit on/off for /api/v1/dev/*
# Install command on the connect page
Y_MCP_URL=            # dev default http://localhost:3000/mcp
Y_PLUGIN_MARKETPLACE= # default thomas-jichen/Y
# Models. Leave mock for dev/tests.
Y_LLM=mock            # mock | anthropic (not wired in v0)
ANTHROPIC_API_KEY=
Y_EMBEDDINGS=mock     # mock | gte (gte-small via the Supabase `embed` Edge Function)
Y_EMBED_URL=          # default SUPABASE_URL
Y_EMBED_SECRET=       # required with gte (x-y-embed-secret)
Y_DEBUG=

# --- mcp (apps/mcp) -----------------------------------------------------------
Y_CORE_URL=http://127.0.0.1:8787
Y_WEB_URL=http://localhost:5173
Y_CORE_TIMEOUT_MS=20000

# --- web (apps/web, Vite: baked in at build time, public by design) -----------
VITE_MOCKS=                  # 1 = mock data; unset with no VITE_API_URL also means mocks
VITE_API_URL=                # e.g. https://y-core.vercel.app/api/v1; unset = same-origin /api/v1, proxied to Y_CORE_URL
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=      # the publishable key, never a secret key
VITE_DEMO_SECRET=            # hosted demo only; ships in the bundle
VITE_DEV_LOGIN=              # 1 shows the dev/demo login form
