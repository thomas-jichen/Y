{
  "name": "@paceline/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "mcp-use dev --entry src/server.ts",
    "build": "mcp-use build --entry src/server.ts",
    "start": "mcp-use start --host 0.0.0.0",
    "serve": "tsx src/server.ts",
    "deploy:prepare": "tsx scripts/prepare-deploy.ts",
    "deploy:manufact": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "mcp-use": "^2.10.1",
    "@mcp-use/client": "^2.4.4",
    "zod": "^4.6.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@paceline/schema": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^5.0.5",
    "typescript": "^7.0.2",
    "@types/node": "^26.6.5",
    "vite": "^8.3.4",
    "tsx": "^4.23.15",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
