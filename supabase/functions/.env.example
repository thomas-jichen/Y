# Local `supabase functions serve embed --env-file supabase/functions/.env`.
# Copy to supabase/functions/.env (gitignored). In production set it with:
#   supabase secrets set PACELINE_EMBED_SECRET=<value>
# Same value as core's PACELINE_EMBED_SECRET. Random, at least 32 characters:
#   openssl rand -hex 32
PACELINE_EMBED_SECRET=
